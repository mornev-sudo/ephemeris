#!/bin/sh
# Prepare the data-plane NICs named in the router config, before ephemerisd.
set -u
CONFIG=/var/lib/ephemeris/ephemeris.toml
udevadm settle --timeout=30 || true   # let udev finish naming NICs (ens19...)
devices=$(sed -n 's/^[[:space:]]*device[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$CONFIG")
workers=$(sed -n 's/^[[:space:]]*workers[[:space:]]*=[[:space:]]*\([0-9]*\).*/\1/p' "$CONFIG" | head -n1)
workers=${workers:-1}
for dev in $devices; do
    [ -e "/sys/class/net/$dev" ] || { echo "nic-setup: no such device $dev" >&2; continue; }
    ip addr flush dev "$dev"                                   # the kernel must not own these links
    sysctl -qw "net.ipv6.conf.$dev.disable_ipv6=1"             # ...or chatter IPv6 out of them
    ip link set dev "$dev" up
    # One RX queue per worker, and the card's RSS spreading flows evenly
    # over all of them. The table goes back to the driver's default
    # first: one set by an earlier start (perhaps with fewer workers)
    # would otherwise stay as it was, sending nothing to the new queues,
    # and some drivers refuse to change the queue count while it's set.
    ethtool -X "$dev" default 2>/dev/null || true
    ethtool -L "$dev" combined "$workers" 2>/dev/null || true
    ethtool -K "$dev" gro off lro off 2>/dev/null || true      # native XDP needs plain frames
    # Toeplitz over every worker's queue; symmetric where the card can.
    ethtool -X "$dev" equal "$workers" hfunc toeplitz symmetric-xor 2>/dev/null \
        || ethtool -X "$dev" equal "$workers" hfunc toeplitz 2>/dev/null \
        || ethtool -X "$dev" equal "$workers" 2>/dev/null || true
done

# The host path: SSH and the portal on inside interfaces that offer them
# (interface management = [...]). ephemerisd hands their packets to the tun
# device eph-host, addressed to 169.254.240.<interface + 1>; that whole range
# is local here, and anything sent from it goes back into eph-host (table
# 240), where ephemerisd gives it the interface's real address again. Every
# step can run again on the next start.
modprobe tun 2>/dev/null || true
ip tuntap add dev eph-host mode tun 2>/dev/null || true
sysctl -qw net.ipv6.conf.eph-host.disable_ipv6=1 2>/dev/null || true
ip link set dev eph-host up
ip route replace local 169.254.240.0/20 dev eph-host table local
ip route replace default dev eph-host table 240
ip rule del from 169.254.240.0/20 lookup 240 2>/dev/null || true
ip rule add from 169.254.240.0/20 lookup 240 priority 100
