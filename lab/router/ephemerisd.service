[Unit]
Description=Ephemeris router data plane
After=ephemeris-nic-setup.service network-online.target
Requires=ephemeris-nic-setup.service

[Service]
ExecStart=/usr/local/sbin/ephemerisd --config /etc/ephemeris/ephemeris.toml
Restart=always
RestartSec=2
# AF_XDP, BPF and locked memory need these; nothing else.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_BPF CAP_SYS_ADMIN CAP_IPC_LOCK CAP_SYS_RESOURCE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_BPF CAP_SYS_ADMIN CAP_IPC_LOCK CAP_SYS_RESOURCE
LimitMEMLOCK=infinity
ProtectSystem=strict
# The sandbox makes the whole file system read-only for ephemerisd, except its
# own state: config + history, API token, admin password, sessions.
ReadWritePaths=/var/lib/ephemeris
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
